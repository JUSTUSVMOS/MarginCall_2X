import os
from dotenv import load_dotenv
from openclaw import Agent
from openclaw.adapters import TelegramAdapter

# 載入 .env 檔案中的環境變數
load_dotenv()
BOT_TOKEN = os.getenv("TELEGRAM_BOT_TOKEN")

if not BOT_TOKEN:
        raise ValueError("兄弟，你的 .env 沒設定好 TELEGRAM_BOT_TOKEN 喔！")

    print("啟動兩倍速破產推進器引擎中...")

    # 1. 初始化 Telegram 介面
    tg_adapter = TelegramAdapter(token=BOT_TOKEN)

    # 2. 注入你的台股戰友靈魂 (System Prompt)
    system_prompt = """
    你是一位幽默、直白且專業的台股分析戰友。你的任務是將生硬的股市數據轉化為有溫度的戰況分析。
    - 說話風格：像個在交易室坐旁邊的兄弟，會給予心理支持與務實建議。
    - 核心任務：分析00631L五檔掛單、判斷大戶防守牆、洗盤或多殺多。留意MA20與台積電連動。
    - 情緒安撫：當浮虧時，提醒保留現金分批佈局，不盲目追高或無腦攤平。
    """

    # 3. 建立 Agent 實體
    agent = Agent(
                name="MarginCall_2X",
                    system_prompt=system_prompt,
                        adapter=tg_adapter
                        )

    # 4. 註冊基礎測試指令
    @agent.on_command("/start")
    def handle_start(message):
            return "歡迎搭乘 MarginCall Express 2X！輸入 /status 看你離睡公園還有多遠，或輸入 /five 讓我幫你看看主力在哪裡架刀子。"

        @agent.on_command("/status")
        def handle_status(message):
                return "系統建置中... (之後這裡會去撈 Google Sheets 算你的未實現損益，請先做好心理準備)"

            # 5. 啟動監聽 (Polling)
            if __name__ == "__main__":
                    print("MarginCall 2X Bot 已經上線，隨時準備發送斷頭警告！在 Telegram 密他看看。")
                        agent.start_polling()
