+
+    ma20 = close.rolling(window=20).mean()
+    ma60 = close.rolling(window=60).mean()
+    std20 = close.rolling(window=20).std()
+    upper = ma20 + (std20 * 2)
+    lower = ma20 - (std20 * 2)
+
+    try:
+        info = ticker.info or {}
+    except Exception as e:
+        logger.debug(f"Failed to fetch info for technical snapshot {s}: {e}")
