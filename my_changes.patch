+def _compute_vwap(df: pd.DataFrame) -> pd.Series:
+    typical = (df['High'] + df['Low'] + df['Close']) / 3
+    cumulative_volume = df['Volume'].cumsum().replace(0, np.nan)
+    return (typical * df['Volume']).cumsum() / cumulative_volume
+
