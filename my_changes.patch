+def _resolve_technical_interval(interval: str | None) -> tuple[str, str]:
+    requested_interval = (interval or "1d").lower()
+    tech_period_by_interval = {
+        "1d": "6mo",
+        "1wk": "3y",
+        "1mo": "10y",
+    }
