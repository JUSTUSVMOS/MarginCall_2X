[Unit]
Description=MarginCall 2X Bot Service
After=network.target

[Service]
WorkingDirectory=/home/margincaller/MarginCall_2X
Environment="PYTHONPATH=/home/margincaller/MarginCall_2X"
Environment="PYTHONIOENCODING=utf-8"
Environment="PYTHONUNBUFFERED=1"

# 啟動命令
ExecStart=/home/margincaller/MarginCall_2X/venv/bin/python /home/margincaller/MarginCall_2X/main.py

# 快速關閉：不等待，直接送 SIGKILL (解決卡住問題)
KillMode=process
SendSIGKILL=yes
TimeoutStopSec=2s

# 自動重啟
Restart=always
RestartSec=5

User=margincaller
StandardOutput=append:/home/margincaller/MarginCall_2X/bot.log
StandardError=append:/home/margincaller/MarginCall_2X/bot.log

[Install]
WantedBy=multi-user.target
